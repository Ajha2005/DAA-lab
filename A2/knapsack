#include <bits/stdc++.h>
using namespace std;
struct Item {
    int value, weight;
};
bool cmp(Item a, Item b) {
    double r1 = (double)a.value / a.weight;
    double r2 = (double)b.value / b.weight;
    return r1 > r2;
}
int main() {
    int n = 3;
    int W = 50;
    vector<Item> items = {
        {100, 20},
        {60, 10},
        {120, 40}
    };
    sort(items.begin(), items.end(), cmp);
    double totalValue = 0.0;
    for (int i = 0; i < n; i++) {
        if (W >= items[i].weight) {
            W -= items[i].weight;
            totalValue += items[i].value;
        } else {
            totalValue += items[i].value * ((double)W / items[i].weight);
            break;
        }
    }

    cout << "Maximum value = " << totalValue;
}
